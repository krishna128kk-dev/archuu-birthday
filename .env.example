# Copy this file to `.env` for local serverless testing (e.g. `vercel dev` /
# `netlify dev`), and set the same two values in your host's dashboard
# (Vercel: Project Settings → Environment Variables. Netlify: Site
# configuration → Environment variables) before deploying.
#
# NEVER commit the real `.env` file — it's already excluded in .gitignore.

# Create a bot with @BotFather on Telegram, then paste the token it gives you.
TELEGRAM_BOT_TOKEN=

# The chat ID that should receive visit notifications (usually your own
# Telegram user ID — message @userinfobot to get it, or use a group/channel
# ID if you'd rather notifications land there).
TELEGRAM_CHAT_ID=
